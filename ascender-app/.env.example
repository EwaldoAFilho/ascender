# ==== Banco de dados (PostgreSQL) ====
# No docker-compose o host é "db"; localmente use "localhost".
DATABASE_URL=postgresql://ascender:ascender@db:5432/ascender

# ==== Criptografia das credenciais de integração (AES-256-GCM) ====
# Chave mestra de 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ==== Sessão (iron-session) ====
# Segredo com no mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ==== Login único compartilhado (seed inicial) ====
# Usado apenas na primeira subida para criar a credencial no banco.
# A senha pode ser trocada depois pela própria aplicação.
LOGIN_EMAIL=admin@ascender.com.br
LOGIN_PASSWORD=

# ==== Aplicação ====
APP_BASE_URL=http://localhost:3000
NODE_ENV=production

# Observação: as chaves reais da API SolisCloud NÃO ficam aqui.
# Elas são cadastradas (cifradas) pela tela Configurações > Integrações.
